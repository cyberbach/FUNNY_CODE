<Window x:Class="GenMotionDesign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GenMotionDesign - Генератор моушен-дизайна" Height="800" Width="1200">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- API Settings -->
        <GroupBox Grid.Row="0" Header="Настройки API" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="API Key:"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtApiKey" Text="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"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Модель:"/>
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="txtModel" Text="deepseek/deepseek-chat"/>

                <Label Grid.Row="1" Grid.Column="0" Content="URL:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtUrl" 
                         Text="https://openrouter.ai/api/v1/chat/completions"/>
            </Grid>
        </GroupBox>

        <!-- Prompts -->
        <GroupBox Grid.Row="1" Header="Промты" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Системный промт:"/>
                <TextBox Grid.Row="1" x:Name="txtSystemPrompt" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="Ты - HTML-генератор моушен-дизайна. Создавай только ГОТОВЫЙ HTML с CSS-анимациями. Каждая буква должна быть в отдельном &lt;span&gt; с классом letter. Используй nth-child для разных букв. Анимации: fade-in, slide, bounce, rotate, scale. Анимация должна работать для ВСЕХ букв. НЕ пиши пояснений. ВЫВОДИ ТОЛЬКО ЧИСТЫЙ HTML."/>
            </Grid>
        </GroupBox>

        <!-- User Input -->
        <GroupBox Grid.Row="2" Header="Запрос" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="txtUserPrompt" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Text="анимация появления текста ПРИВЕТ на черном фоне разноцветными буквами"/>
                <Button Grid.Column="1" x:Name="btnGenerate" Content="Сгенерировать" Click="BtnGenerate_Click" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- AI Response -->
        <GroupBox Grid.Row="3" Header="Ответ нейронки (HTML код)" Margin="0,0,0,10">
            <TextBox x:Name="txtAiResponse" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </GroupBox>

        <!-- Preview -->
        <GroupBox Grid.Row="4" Header="Превью" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#333" BorderThickness="1">
                    <wv2:WebView2 x:Name="webPreview"/>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="btnPlay" Content="Play" Click="BtnPlay_Click"/>
                    <Button x:Name="btnPause" Content="Pause" Click="BtnPause_Click"/>
                    <Button x:Name="btnStop" Content="Stop" Click="BtnStop_Click"/>
                    <Label Content="Кадр:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="txtCurrentFrame" Width="50" Text="0" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Label Content="/" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtLastFrame" Width="50" Text="0" IsReadOnly="True" VerticalAlignment="Center"/>
                    <Label Content="FPS:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="txtFPS" Width="40" Text="30" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chkTransparent" Content="Прозрачный фон" VerticalAlignment="Center" Margin="10,0"/>
                    <Label Content="Ширина:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtWidth" Width="60" Text="512" VerticalAlignment="Center"/>
                    <Label Content="Высота:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtHeight" Width="60" Text="512" VerticalAlignment="Center"/>
                    <Button x:Name="btnExport" Content="Export to MP4" Click="BtnExport_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Status -->
        <TextBlock Grid.Row="5" x:Name="txtStatus" Text="Ready" Foreground="Gray"/>
    </Grid>
</Window>
